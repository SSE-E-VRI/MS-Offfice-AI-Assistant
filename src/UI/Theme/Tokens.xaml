<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens (Phase 0.3).

        This is a straight extraction of the palette already inlined across ChatSidebar.xaml,
        SettingsWindow.xaml, and UI/Helpers/MarkdownHelper.cs — a coherent Tailwind Slate/Blue
        set. Values are unchanged; only the naming is new. Do not "improve" or re-tune colors
        here without a corresponding visual design pass (Phase A).

        Two tiers:
          1. Color primitives (Tailwind swatch names) — the raw palette.
          2. Semantic brushes — what the rest of the app should actually reference.
        Consumers should use the semantic brushes below, not the primitives directly.
    -->

    <!-- ===================== 1. Color primitives ===================== -->

    <Color x:Key="ColorWhite">#FFFFFFFF</Color>
    <Color x:Key="ColorNeutral50">#FFFAFAFA</Color>

    <Color x:Key="ColorSlate50">#FFF8FAFC</Color>
    <Color x:Key="ColorSlate100">#FFF1F5F9</Color>
    <Color x:Key="ColorSlate200">#FFE2E8F0</Color>
    <Color x:Key="ColorSlate300">#FFCBD5E1</Color>
    <Color x:Key="ColorSlate400">#FF94A3B8</Color>
    <Color x:Key="ColorSlate500">#FF64748B</Color>
    <Color x:Key="ColorSlate600">#FF475569</Color>
    <Color x:Key="ColorSlate700">#FF334155</Color>
    <Color x:Key="ColorSlate800">#FF1E293B</Color>
    <Color x:Key="ColorSlate900">#FF0F172A</Color>

    <Color x:Key="ColorBlue50">#FFEFF6FF</Color>
    <Color x:Key="ColorBlue100">#FFDBEAFE</Color>
    <Color x:Key="ColorBlue200">#FFBFDBFE</Color>
    <Color x:Key="ColorBlue300">#FF93C5FD</Color>
    <Color x:Key="ColorBlue600">#FF2563EB</Color>
    <Color x:Key="ColorBlue700">#FF1D4ED8</Color>
    <Color x:Key="ColorBlue800">#FF1E40AF</Color>
    <Color x:Key="ColorBlue900">#FF1E3A8A</Color>

    <Color x:Key="ColorIndigo100">#FFE0E7FF</Color>
    <Color x:Key="ColorIndigo800">#FF3730A3</Color>

    <Color x:Key="ColorAmber100">#FFFEF3C7</Color>
    <Color x:Key="ColorAmber300">#FFFCD34D</Color>
    <Color x:Key="ColorAmber600">#FFD97706</Color>
    <Color x:Key="ColorAmber700">#FFB45309</Color>
    <Color x:Key="ColorAmber800">#FF92400E</Color>

    <Color x:Key="ColorRed100">#FFFEE2E2</Color>
    <Color x:Key="ColorRed300">#FFFCA5A5</Color>
    <Color x:Key="ColorRed600">#FFDC2626</Color>

    <Color x:Key="ColorGreen300">#FF86EFAC</Color>
    <Color x:Key="ColorEmerald600">#FF059669</Color>
    <Color x:Key="ColorEmerald700">#FF047857</Color>

    <!-- ===================== 2. Semantic brushes ===================== -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorWhite}"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource ColorNeutral50}"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource ColorSlate50}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSlate100}"/>
    <SolidColorBrush x:Key="SurfaceInverseBrush" Color="{StaticResource ColorSlate800}"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorSlate200}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColorSlate300}"/>

    <!-- Ink (text) -->
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource ColorSlate800}"/>
    <SolidColorBrush x:Key="InkStrongBrush" Color="{StaticResource ColorSlate900}"/>
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource ColorSlate700}"/>
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource ColorSlate600}"/>
    <SolidColorBrush x:Key="InkSubtleBrush" Color="{StaticResource ColorSlate500}"/>
    <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource ColorSlate400}"/>
    <SolidColorBrush x:Key="InkOnDarkBrush" Color="{StaticResource ColorWhite}"/>

    <!-- Primary (blue) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorBlue600}"/>
    <SolidColorBrush x:Key="PrimaryStrongBrush" Color="{StaticResource ColorBlue700}"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource ColorBlue800}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource ColorBlue900}"/>
    <SolidColorBrush x:Key="PrimaryFaintBrush" Color="{StaticResource ColorBlue300}"/>
    <SolidColorBrush x:Key="PrimaryBorderFaintBrush" Color="{StaticResource ColorBlue200}"/>
    <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="{StaticResource ColorBlue100}"/>
    <SolidColorBrush x:Key="PrimarySurfaceFaintBrush" Color="{StaticResource ColorBlue50}"/>

    <!-- Accent (indigo — action badges) -->
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource ColorIndigo100}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource ColorIndigo800}"/>

    <!-- Success (emerald) -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorEmerald600}"/>
    <SolidColorBrush x:Key="SuccessStrongBrush" Color="{StaticResource ColorEmerald700}"/>
    <SolidColorBrush x:Key="SuccessFaintBrush" Color="{StaticResource ColorGreen300}"/>

    <!-- Danger (red) -->
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorRed600}"/>
    <SolidColorBrush x:Key="DangerFaintBrush" Color="{StaticResource ColorRed300}"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource ColorRed100}"/>

    <!-- Warning (amber) -->
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorAmber600}"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource ColorAmber100}"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource ColorAmber300}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource ColorAmber800}"/>

    <!-- Code (inline code text, used by MarkdownHelper) -->
    <SolidColorBrush x:Key="CodeInlineTextBrush" Color="{StaticResource ColorAmber700}"/>

    <!--
        Risk-level brushes (Core.Actions.OfficeAction.RiskLevel 0-3). Not yet wired into any
        control — Phase A's action-card visual design consumes these. Added now so the token
        set is complete; values simply mirror the existing status-color convention used by
        OfficeAction.StatusForegroundBrush (emerald=applied, blue=applying, amber=rolled back,
        red=failed).
    -->
    <SolidColorBrush x:Key="RiskLevel0Brush" Color="{StaticResource ColorSlate500}"/>
    <SolidColorBrush x:Key="RiskLevel1Brush" Color="{StaticResource ColorBlue600}"/>
    <SolidColorBrush x:Key="RiskLevel2Brush" Color="{StaticResource ColorAmber600}"/>
    <SolidColorBrush x:Key="RiskLevel3Brush" Color="{StaticResource ColorRed600}"/>

</ResourceDictionary>
