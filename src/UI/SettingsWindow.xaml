<Window x:Class="MistralOfficeAddin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mistral AI - Configuration" Height="580" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="Mistral AI Configuration" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
            </StackPanel>
            <TextBlock Text="Bring Your Own Key (BYOK) - Stored securely via Windows DPAPI" 
                       Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Settings Card -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                <StackPanel>
                    <!-- API Key -->
                    <TextBlock Text="API Key *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtApiKey" Grid.Column="0" Margin="0,0,6,0"/>
                        <Button x:Name="BtnToggleKey" Grid.Column="1" Content="👁" Width="36" 
                                Background="#F3F4F6" Foreground="#374151" Click="BtnToggleKey_Click"
                                ToolTip="Show/Hide API Key"/>
                    </Grid>
                    <TextBox x:Name="TxtApiKeyPlain" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- Base URL -->
                    <TextBlock Text="API Base URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBaseUrl" Text="https://api.mistral.ai/v1" Margin="0,0,0,12"/>

                    <!-- Default Model -->
                    <TextBlock Text="Default AI Model" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbModel" Margin="0,0,0,12" Padding="6,4">
                        <ComboBoxItem Content="mistral-large-latest" IsSelected="True"/>
                        <ComboBoxItem Content="mistral-small-latest"/>
                        <ComboBoxItem Content="open-mistral-nemo"/>
                        <ComboBoxItem Content="codestral-latest"/>
                    </ComboBox>

                    <!-- Temperature -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Temperature (Creativity)" FontWeight="SemiBold" Grid.Column="0"/>
                        <TextBlock x:Name="LblTemp" Text="0.7" FontWeight="Bold" Foreground="#3B82F6" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="SldTemp" Minimum="0.0" Maximum="1.0" Value="0.7" SmallChange="0.05" LargeChange="0.1" 
                            TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="SldTemp_ValueChanged" Margin="0,0,0,12"/>

                    <!-- Max Tokens -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Tokens" FontWeight="SemiBold" Grid.Column="0"/>
                        <TextBlock x:Name="LblMaxTokens" Text="4096" FontWeight="Bold" Foreground="#3B82F6" Grid.Column="1"/>
                    </Grid>
                    <Slider x:Name="SldMaxTokens" Minimum="256" Maximum="8192" Value="4096" SmallChange="256" LargeChange="1024" 
                            TickFrequency="256" IsSnapToTickEnabled="True" ValueChanged="SldMaxTokens_ValueChanged" Margin="0,0,0,12"/>

                    <!-- System Prompt -->
                    <TextBlock Text="System Instructions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSystemPrompt" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Test Connection & Status -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnTest" Grid.Column="0" Content="Test Connection" 
                    Background="#E5E7EB" Foreground="#1F2937" Click="BtnTest_Click"/>
            <TextBlock x:Name="LblStatus" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" 
                       TextWrapping="Wrap" FontSize="12" Foreground="#059669"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,8,0" Width="90" 
                    Background="#E5E7EB" Foreground="#374151" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Save Settings" Width="120" 
                    Background="#2563EB" Foreground="#FFFFFF" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
