<Window x:Class="MSOfficeAIAssistant.UI.ActionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MSOfficeAIAssistant.UI.Converters"
        Title="AI Action Log" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource SurfaceSubtleBrush}" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:UtcToLocalTimeConverter x:Key="UtcToLocalConverter"/>
            <converters:MarkdownPlainTextConverter x:Key="PlainTextConverter"/>
            <converters:PreviewTextConverter x:Key="PreviewConverter"/>
            <converters:LongTextToVisibilityConverter x:Key="LongTextConverter"/>
            <converters:UndoableTextConverter x:Key="UndoableConverter"/>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0"/>
                <TextBlock Text="Recent AI Actions" FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkStrongBrush}"/>
            </StackPanel>
            <TextBlock Text="Recently approved and executed AI actions (stored locally and encrypted)" Foreground="{StaticResource InkSubtleBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Actions List -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <ListBox x:Name="ActionsListBox" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimestampUtc, Converter={StaticResource UtcToLocalConverter}, StringFormat=g}" FontWeight="Bold" Foreground="{StaticResource InkStrongBrush}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Host}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ActionType}" Foreground="{StaticResource InkMutedBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="3" FontSize="10" Foreground="{StaticResource InkMutedBrush}" FontWeight="SemiBold" Margin="8,0,0,0" Text="{Binding Undoable, Converter={StaticResource UndoableConverter}}"/>

                            </Grid>
                            <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Target: "/>
                                <Run Text="{Binding Target}"/>
                            </TextBlock>
                            <TextBlock Margin="0,0,0,4" FontSize="11" Foreground="{StaticResource InkBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Summary, Converter={StaticResource PreviewConverter}}"/>
                            <Expander Margin="0,0,0,6" FontSize="11" Foreground="{StaticResource InkMutedBrush}"
                                      Header="Full content"
                                      Visibility="{Binding Summary, Converter={StaticResource LongTextConverter}}">
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8" Margin="0,6,0,0">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkBrush}"
                                                   Text="{Binding Summary, Converter={StaticResource PlainTextConverter}}"/>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                            <TextBlock FontSize="10" Foreground="{StaticResource InkSubtleBrush}">
                                <Run Text="Model: "/>
                                <Run Text="{Binding Model}" FontFamily="Consolas"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Empty State -->
        <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="No approved AI actions have been recorded on this Windows account yet."
                   Foreground="{StaticResource InkSubtleBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                   Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="85"
                    Background="{StaticResource SurfaceAltBrush}"
                    Foreground="{StaticResource InkSecondaryBrush}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
