<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="tabAIAssistant" label="AI Assistant">
        <group id="grpChat" label="Chat">
          <button id="btnToggleSidebar" label="Open AI Chat"
                  imageMso="FileOpen" size="large"
                  onAction="OnToggleSidebar"/>
          <button id="btnNewChat" label="New Chat"
                  imageMso="FileNew" size="large"
                  onAction="OnNewChat"/>
          <button id="btnSettings" label="Configure"
                  imageMso="FileSave" size="large"
                  onAction="OnOpenSettings"/>
        </group>
        <group id="grpDraft" label="Draft">
          <button id="btnGenerate" label="Generate"
                  imageMso="Copy" size="large"
                  onAction="OnGenerate"/>
          <button id="btnContinue" label="Continue"
                  imageMso="Paste" size="large"
                  onAction="OnContinueWriting"/>
          <button id="btnSummarize" label="Summarize"
                  imageMso="Cut" size="large"
                  onAction="OnSummarize"/>
          <button id="btnRewrite" label="Rewrite"
                  imageMso="Undo" size="large"
                  onAction="OnRewrite"/>
        </group>
        <group id="grpMore" label="More">
          <button id="btnExpand" label="Expand" imageMso="Bold" size="normal" onAction="OnExpand"/>
          <button id="btnShorten" label="Shorten" imageMso="Italic" size="normal" onAction="OnShorten"/>
          <button id="btnOutline" label="Outline" imageMso="Redo" size="normal" onAction="OnOutline"/>
          <button id="btnActionItems" label="Actions" imageMso="FileOpen" size="normal" onAction="OnActionItems"/>
          <button id="btnReviewContent" label="Review" imageMso="FileNew" size="normal" onAction="OnReviewContent"/>
          <button id="btnBuildDeck" label="Slides" imageMso="FileSave" size="normal" onAction="OnBuildSlides"/>
          <menu id="mnuTranslate" label="Translate" imageMso="Language" size="normal"
                screentip="Translate"
                supertip="Translate the current selection or context into the chosen language.">
            <button id="btnTransTA" label="Tamil" onAction="OnTranslate"/>
            <button id="btnTransHI" label="Hindi" onAction="OnTranslate"/>
            <button id="btnTransTE" label="Telugu" onAction="OnTranslate"/>
            <button id="btnTransKN" label="Kannada" onAction="OnTranslate"/>
            <button id="btnTransML" label="Malayalam" onAction="OnTranslate"/>
            <button id="btnTransBN" label="Bengali" onAction="OnTranslate"/>
            <button id="btnTransMR" label="Marathi" onAction="OnTranslate"/>
            <button id="btnTransGU" label="Gujarati" onAction="OnTranslate"/>
            <button id="btnTransEN" label="English" onAction="OnTranslate"/>
          </menu>
        </group>
        <group id="grpHelp" label="Help">
          <button id="btnUserManual" label="User Manual"
                  imageMso="Help" size="large"
                  screentip="User Manual"
                  supertip="Open the AI Assistant user manual in a window. Describes every ribbon and panel control, example prompts, and railway office workflows. Works without an API key."
                  onAction="OnOpenUserManual"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
